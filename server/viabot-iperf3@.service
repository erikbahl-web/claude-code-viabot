# iperf3 server for the survey rigs, one instance per port.
#
#   sudo systemctl enable --now viabot-iperf3@5201   # uplink tests
#   sudo systemctl enable --now viabot-iperf3@5202   # downlink tests
#
# Two instances because one iperf3 server runs one test at a time, and the rig
# measures both directions at once — a teleop session is asymmetric, and the
# two halves fail differently.
#
# Authentication is not optional. This port is reachable from the whole
# internet — it has to be, because the rig arrives from a different carrier
# address every walk — and an open iperf3 server is a bandwidth allowance that
# anyone who finds it can spend.
[Unit]
Description=iperf3 server for ViaBot coverage surveys (port %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=viabot
Group=viabot
# What --rcv-timeout does here, measured, because the first account of it in
# this file was wrong.
#
# One iperf3 server runs one test at a time. When a rig's link dies mid-test
# the server never learns the client has gone: it is left holding a live TCP
# control connection that has simply stopped talking, and every later test
# gets "the server is busy running a test. try again later".
#
# Measured 2026-11-22 against 3.16, freezing an uplink client mid-test with
# SIGSTOP so its socket stays open and silent, which is what a rig in a dead
# zone looks like, then timing how long the server stays busy:
#
#   --rcv-timeout 8000     8.6 s
#   --rcv-timeout 9500     9.6 s
#   --rcv-timeout 10500   46.6 s
#   --rcv-timeout 15000   46.7 s
#   no flag at all        46.6 s
#
# So values of ten seconds and over do nothing on 3.16: it counts each
# ten-second empty read as a block received and never reaches the timeout.
# What frees the server at 46 s is its own end-of-test timer, the test's
# duration plus forty seconds. This file used to say 15000 freed it in 15 s.
# That figure was the 8000 measurement, carried over when the value was raised
# and never taken again.
#
# The value is left at 15000 on purpose. 8000 does work, but it would also
# abort a real burst that loses eight seconds to a dead zone and then comes
# back, throwing away the seconds either side that did arrive. The rig waits
# longer than 46 s after a failed burst anyway.
#
# Two things this flag does NOT protect against, both found the same day:
#
#   * A vanished *downlink* client (-R -t 0) is never dropped. The server went
#     on transmitting at nobody, and answering "busy", for nineteen minutes
#     until the test was stopped. Nothing but a restart ends it.
#   * The server can wedge outright: an uplink test whose first UDP datagram
#     never arrives, followed by any other connection to the port, leaves the
#     main thread spinning for good. viabot-iperf3-heal.service exists for
#     that, and restarts every instance once a night for the one above.
#
# --idle-timeout does not help with any of this, despite reading as though it
# should. It covers a server with no connection at all. Do not swap it in.
ExecStart=/usr/bin/iperf3 --server --port %i \
  --rcv-timeout 15000 \
  --rsa-private-key-path /etc/viabot/iperf3_private.pem \
  --authorized-users-path /etc/viabot/iperf3_users.csv
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
